# VITE_GEMINI_API_KEY: Required for AI features.
# In AI Studio, this is injected automatically as GEMINI_API_KEY.
# On Cloudflare Pages, add this to your Settings > Variables and Secrets.
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# APP_URL: The URL where this app is hosted.
APP_URL=
