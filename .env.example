# VITE_GEMINI_API_KEY: Required for Gemini AI API calls on the client side (e.g. Vercel/Netlify).
# In AI Studio, this is injected automatically.
# On Vercel, add this to your Project Settings > Environment Variables.
VITE_GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
