# VITE_GEMINI_API_KEY: Required for Gemini AI API calls on the client side (e.g. Netlify).
# In AI Studio, this is injected automatically.
# On Netlify, add this to your Site Settings > Environment Variables.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
