rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Rules
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email']) &&
               data.uid is string &&
               data.email is string &&
               data.uid == request.auth.uid;
      }

      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && 
                      isValidUser(request.resource.data) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName', 'currentModule', 'completedModules', 'savedPoems', 'lastActive', 'streak', 'bestStreak', 'streakLastUpdated']);
    }

    // Bookmarks Rules
    match /users/{userId}/bookmarks/{bookmarkId} {
      function isValidBookmark(data) {
        return data.keys().hasAll(['userId', 'type', 'itemReference']) &&
               data.userId == request.auth.uid &&
               data.type in ['word', 'poem', 'literature'] &&
               data.itemReference is string;
      }

      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidBookmark(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // History Rules
    match /users/{userId}/history/{historyId} {
      function isValidHistory(data) {
        return data.keys().hasAll(['userId', 'activityType', 'timestamp']) &&
               data.userId == request.auth.uid &&
               data.activityType in ["dictionary_search", "quiz_completion", "pronunciation_practice", "literature_read", "user_login", "word_discovery"] &&
               data.timestamp is string;
      }

      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidHistory(request.resource.data);
    }
  }
}
