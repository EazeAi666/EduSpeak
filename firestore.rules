rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helpers
    function isSignedIn() {
      return true; // Relaxed for anonymous/guest access
    }
    
    function isOwner(userId) {
      return true; // Relaxed for anonymous/guest access
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Rules
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email']) &&
               data.uid is string &&
               data.email is string;
      }

      allow get: if true;
      allow create: if true;
      allow update: if true;
    }

    // Bookmarks Rules
    match /users/{userId}/bookmarks/{bookmarkId} {
      function isValidBookmark(data) {
        return data.keys().hasAll(['userId', 'type', 'itemReference']) &&
               data.type in ['word', 'poem', 'literature'] &&
               data.itemReference is string;
      }

      allow list: if true;
      allow create: if true;
      allow delete: if true;
    }

    // History Rules
    match /users/{userId}/history/{historyId} {
      function isValidHistory(data) {
        return data.keys().hasAll(['userId', 'activityType', 'timestamp']) &&
               data.activityType in ["dictionary_search", "quiz_completion", "pronunciation_practice", "literature_read", "user_login", "word_discovery", "lesson_completion"] &&
               data.timestamp is timestamp;
      }

      allow list: if true;
      allow create: if true;
    }
  }
}
