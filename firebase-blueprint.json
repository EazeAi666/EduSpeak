{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user progress and preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "currentModule": { "type": "string" },
        "completedModules": { "type": "array", "items": { "type": "string" } },
        "savedPoems": { "type": "array", "items": { "type": "string" } },
        "lastActive": { "type": "string", "format": "date-time" },
        "streak": { "type": "number" },
        "bestStreak": { "type": "number" },
        "streakLastUpdated": { "type": "string", "format": "date-time" },
        "points": { "type": "number" },
        "level": { "type": "number" }
      },
      "required": ["uid", "email"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "Saved dictionary words or literature items.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["word", "poem", "literature"] },
        "itemReference": { "type": "string" },
        "savedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "itemReference"]
    },
    "HistoryRecord": {
      "title": "History Record",
      "description": "Tracks all activities like searches, quiz scores, and practice sessions.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "activityType": { "type": "string", "enum": ["dictionary_search", "quiz_completion", "pronunciation_practice", "literature_read", "user_login", "word_discovery"] },
        "content": { "type": "object" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "activityType", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "Collection of user secondary data."
    },
    "users/{userId}/bookmarks/{bookmarkId}": {
      "schema": "Bookmark",
      "description": "User specific bookmarks."
    },
    "users/{userId}/history/{historyId}": {
      "schema": "HistoryRecord",
      "description": "Logs of user academic activities."
    }
  }
}
